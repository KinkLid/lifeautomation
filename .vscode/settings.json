{
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.indentSize": 2,

  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,

  "editor.renderWhitespace": "boundary",

  "files.watcherExclude": {
    "**/target/**": true
  }
}
